<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AudioFXStation.App"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />

        <!-- ═══════════════════════════════════════════════════════════════
             LIQUID GLASS THEME LAYER
             Shared visuals: glass buttons with ripple, glass sliders with
             glowing fill + droplet thumbs, glass cards & viewports.
             ═══════════════════════════════════════════════════════════════ -->
        <Styles>

            <Styles.Resources>
                <ResourceDictionary>

                    <!-- ── easing curves ─────────────────────────────────── -->
                    <SplineEasing x:Key="EaseSmooth" X1="0.4" Y1="0" X2="0.2" Y2="1" />
                    <SplineEasing x:Key="EaseSpring" X1="0.34" Y1="1.45" X2="0.64" Y2="1" />

                    <!-- ── shared brushes ────────────────────────────────── -->
                    <LinearGradientBrush x:Key="ThumbGlass" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#F0FFFFFF" Offset="0" />
                        <GradientStop Color="#30FFFFFF" Offset="1" />
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="GradAccent" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#78EEFF" Offset="0" />
                        <GradientStop Color="#3E9BFF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GradAccentHover" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#A2F4FF" Offset="0" />
                        <GradientStop Color="#66BCFF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="GradAccentPressed" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#5BD3EA" Offset="0" />
                        <GradientStop Color="#2E82D6" Offset="1" />
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="GradMeter" StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#FF5CA8" Offset="0" />
                        <GradientStop Color="#B07CFF" Offset="1" />
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="SliderFillDefault" StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#5EEAFF" Offset="0" />
                        <GradientStop Color="#9A7CFF" Offset="1" />
                    </LinearGradientBrush>

                    <!-- ── slider track part themes ──────────────────────── -->

                    <!-- glowing progress line (decrease side) -->
                    <ControlTheme x:Key="GlassTrackFillH" TargetType="RepeatButton">
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Grid Background="Transparent">
                                    <Border Height="8" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{TemplateBinding Background}"
                                            BoxShadow="0 0 12 1 #54FFFFFF" />
                                </Grid>
                            </ControlTemplate>
                        </Setter>
                    </ControlTheme>

                    <!-- recessed glass groove (increase side) -->
                    <ControlTheme x:Key="GlassTrackRestH" TargetType="RepeatButton">
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Grid Background="Transparent">
                                    <Border Height="8" CornerRadius="4" VerticalAlignment="Center"
                                            Background="{TemplateBinding Background}"
                                            BoxShadow="inset 0 2 3 0 #5C000000, inset 0 -1 0 0 #1CFFFFFF" />
                                </Grid>
                            </ControlTemplate>
                        </Setter>
                    </ControlTheme>

                    <ControlTheme x:Key="GlassTrackFillV" TargetType="RepeatButton">
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Grid Background="Transparent">
                                    <Border Width="8" CornerRadius="4" HorizontalAlignment="Center"
                                            Background="{TemplateBinding Background}"
                                            BoxShadow="0 0 12 1 #54FFFFFF" />
                                </Grid>
                            </ControlTemplate>
                        </Setter>
                    </ControlTheme>

                    <ControlTheme x:Key="GlassTrackRestV" TargetType="RepeatButton">
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Grid Background="Transparent">
                                    <Border Width="8" CornerRadius="4" HorizontalAlignment="Center"
                                            Background="{TemplateBinding Background}"
                                            BoxShadow="inset 0 2 3 0 #5C000000, inset 0 -1 0 0 #1CFFFFFF" />
                                </Grid>
                            </ControlTemplate>
                        </Setter>
                    </ControlTheme>

                    <!-- volumetric glass droplet thumb with specular highlight -->
                    <ControlTheme x:Key="GlassSliderThumb" TargetType="Thumb">
                        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
                        <Setter Property="RenderTransform" Value="scale(1)" />
                        <Setter Property="Transitions">
                            <Transitions>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="{StaticResource EaseSpring}" />
                            </Transitions>
                        </Setter>
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Border Width="24" Height="24" CornerRadius="12"
                                        Background="{StaticResource ThumbGlass}"
                                        BorderBrush="#C4FFFFFF" BorderThickness="1.5"
                                        BoxShadow="0 6 14 0 #4A06101C, 0 0 18 0 #5CFFFFFF">
                                    <Ellipse Width="8" Height="8" Margin="4,3,0,0"
                                             HorizontalAlignment="Left" VerticalAlignment="Top"
                                             Fill="#F2FFFFFF" />
                                </Border>
                            </ControlTemplate>
                        </Setter>
                    </ControlTheme>

                    <!-- ═══ BUTTON · liquid glass capsule with ripple wave ═══ -->
                    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
                <Setter Property="Background" Value="#661A2946" />
                <Setter Property="Foreground" Value="#EAF2FF" />
                <Setter Property="BorderBrush" Value="#33FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="RenderTransformOrigin" Value="50%,50%" />
                <Setter Property="RenderTransform" Value="scale(1)" />
                <Setter Property="Transitions">
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.22" Easing="{StaticResource EaseSmooth}" />
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.22" Easing="{StaticResource EaseSmooth}" />
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.26" Easing="{StaticResource EaseSpring}" />
                    </Transitions>
                </Setter>

                <Setter Property="Template">
                    <ControlTemplate>
                        <Panel>
                            <ContentPresenter x:Name="PART_ContentPresenter"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              BoxShadow="0 4 12 0 #2E06101C, inset 0 1 0 0 #47FFFFFF" />
                            <Ellipse x:Name="PART_Ripple" Stretch="Uniform" Fill="#54FFFFFF" Opacity="0"
                                     RenderTransformOrigin="50%,50%"
                                     IsHitTestVisible="False" />
                        </Panel>
                    </ControlTemplate>
                </Setter>

                <!-- hover: glass lifts & brightens -->
                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="#8C243752" />
                    <Setter Property="BorderBrush" Value="#55FFFFFF" />
                    <Setter Property="RenderTransform" Value="scale(1.02)" />
                </Style>
                <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="BoxShadow" Value="0 8 20 0 #3806101C, inset 0 1 0 0 #5EFFFFFF" />
                </Style>

                <!-- press: pill sinks into the glass -->
                <Style Selector="^:pressed">
                    <Setter Property="Background" Value="#A0324A66" />
                    <Setter Property="BorderBrush" Value="#87E4F7FF" />
                    <Setter Property="RenderTransform" Value="scale(0.97)" />
                </Style>

                <Style Selector="^:focus">
                    <Setter Property="BorderBrush" Value="#80D9F6FF" />
                </Style>

                <Style Selector="^:disabled">
                    <Setter Property="Opacity" Value="0.4" />
                </Style>

                <!-- liquid ripple wave on click -->
                <Style Selector="^:pressed /template/ Ellipse#PART_Ripple">
                    <Style.Animations>
                        <Animation Duration="0:0:0.55" Easing="CubicEaseOut">
                            <KeyFrame Cue="0%">
                                <Setter Property="Opacity" Value="0.26" />
                                <Setter Property="ScaleTransform.ScaleX" Value="0.45" />
                                <Setter Property="ScaleTransform.ScaleY" Value="0.45" />
                            </KeyFrame>
                            <KeyFrame Cue="62%">
                                <Setter Property="Opacity" Value="0.09" />
                                <Setter Property="ScaleTransform.ScaleX" Value="1.08" />
                                <Setter Property="ScaleTransform.ScaleY" Value="1.08" />
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="ScaleTransform.ScaleX" Value="1.18" />
                                <Setter Property="ScaleTransform.ScaleY" Value="1.18" />
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>

                <!-- accent: gradient capsule with neon glow -->
                <Style Selector="^.accent">
                    <Setter Property="Background" Value="{StaticResource GradAccent}" />
                    <Setter Property="Foreground" Value="#06131E" />
                    <Setter Property="BorderBrush" Value="#B9FFFFFF" />
                </Style>
                <Style Selector="^.accent /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="BoxShadow" Value="0 6 20 0 #524FE9FF, inset 0 1 0 0 #87FFFFFF" />
                </Style>
                <Style Selector="^.accent:pointerover">
                    <Setter Property="Background" Value="{StaticResource GradAccentHover}" />
                    <Setter Property="RenderTransform" Value="scale(1.03)" />
                </Style>
                <Style Selector="^.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="BoxShadow" Value="0 8 26 0 #6655E9FF, inset 0 1 0 0 #96FFFFFF" />
                </Style>
                <Style Selector="^.accent:pressed">
                    <Setter Property="Background" Value="{StaticResource GradAccentPressed}" />
                    <Setter Property="RenderTransform" Value="scale(0.97)" />
                </Style>
                <Style Selector="^.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
                </Style>
            </ControlTheme>

            <!-- ═══ SLIDER · groove in glass + glowing fill + droplet ════ -->
            <ControlTheme x:Key="{x:Type Slider}" TargetType="Slider">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Background" Value="#7A15203A" />
                <Setter Property="Foreground" Value="{StaticResource SliderFillDefault}" />

                <Style Selector="^:horizontal">
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Grid Background="Transparent" MinHeight="28">
                                <Track x:Name="PART_Track"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value, Mode=TwoWay}"
                                       IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                       Orientation="Horizontal">
                                    <Track.DecreaseButton>
                                        <RepeatButton x:Name="PART_DecreaseButton" Focusable="False"
                                                      Background="{TemplateBinding Foreground}"
                                                      Theme="{StaticResource GlassTrackFillH}" />
                                    </Track.DecreaseButton>
                                    <Track.IncreaseButton>
                                        <RepeatButton x:Name="PART_IncreaseButton" Focusable="False"
                                                      Background="{TemplateBinding Background}"
                                                      Theme="{StaticResource GlassTrackRestH}" />
                                    </Track.IncreaseButton>
                                    <Track.Thumb>
                                        <Thumb Theme="{StaticResource GlassSliderThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter>
                </Style>

                <Style Selector="^:vertical">
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Grid Background="Transparent" MinWidth="28">
                                <Track x:Name="PART_Track"
                                       Minimum="{TemplateBinding Minimum}"
                                       Maximum="{TemplateBinding Maximum}"
                                       Value="{TemplateBinding Value, Mode=TwoWay}"
                                       IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                       Orientation="Vertical">
                                    <Track.DecreaseButton>
                                        <RepeatButton x:Name="PART_DecreaseButton" Focusable="False"
                                                      Background="{TemplateBinding Foreground}"
                                                      Theme="{StaticResource GlassTrackFillV}" />
                                    </Track.DecreaseButton>
                                    <Track.IncreaseButton>
                                        <RepeatButton x:Name="PART_IncreaseButton" Focusable="False"
                                                      Background="{TemplateBinding Background}"
                                                      Theme="{StaticResource GlassTrackRestV}" />
                                    </Track.IncreaseButton>
                                    <Track.Thumb>
                                        <Thumb Theme="{StaticResource GlassSliderThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter>
                </Style>

                <!-- magnetic drag: the droplet swells while sliding -->
                <Style Selector="^:pressed /template/ Thumb">
                    <Setter Property="RenderTransform" Value="scale(1.22)" />
                </Style>
                    </ControlTheme>

                </ResourceDictionary>
            </Styles.Resources>

            <!-- ═══ PROGRESSBAR · glowing meter ═══════════════════════════ -->
            <Style Selector="ProgressBar">
                <Setter Property="Foreground" Value="{StaticResource GradMeter}" />
                <Setter Property="Background" Value="#4A101626" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- ═══ FLOATING GLASS CARDS ══════════════════════════════════ -->
            <Style Selector="Border.glass">
                <Setter Property="Background" Value="#7F101726" />
                <Setter Property="BorderBrush" Value="#24FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="BoxShadow" Value="0 16 38 0 #59061020, inset 0 1 0 0 #47FFFFFF, inset 0 -1 0 0 #0EFFFFFF" />
                <Setter Property="RenderTransformOrigin" Value="50%,50%" />
                <Setter Property="RenderTransform" Value="scale(1)" />
                <Setter Property="Transitions">
                    <Transitions>
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.3" Easing="{StaticResource EaseSmooth}" />
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.34" Easing="{StaticResource EaseSpring}" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="Border.glass:pointerover">
                <Setter Property="BorderBrush" Value="#42FFFFFF" />
                <Setter Property="RenderTransform" Value="scale(1.02)" />
            </Style>

            <!-- nested card inside a glass panel -->
            <Style Selector="Border.glass-in">
                <Setter Property="Background" Value="#15FFFFFF" />
                <Setter Property="BorderBrush" Value="#1CFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="13" />
                <Setter Property="BoxShadow" Value="inset 0 1 0 0 #2EFFFFFF, inset 0 -1 0 0 #0A000000" />
                <Setter Property="Transitions">
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.25" Easing="{StaticResource EaseSmooth}" />
                        <BrushTransition Property="BorderBrush" Duration="0:0:0.25" Easing="{StaticResource EaseSmooth}" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="Border.glass-in:pointerover">
                <Setter Property="Background" Value="#22FFFFFF" />
                <Setter Property="BorderBrush" Value="#30FFFFFF" />
            </Style>

            <!-- deep display viewport -->
            <Style Selector="Border.viewport">
                <Setter Property="Background" Value="#99060B16" />
                <Setter Property="BorderBrush" Value="#1FFFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="BoxShadow" Value="inset 0 3 10 0 #73000000, inset 0 -1 0 0 #17FFFFFF" />
            </Style>

            <!-- hairline divider -->
            <Style Selector="Border.hairline">
                <Setter Property="Height" Value="1" />
                <Setter Property="Background" Value="#17FFFFFF" />
                <Setter Property="CornerRadius" Value="0.5" />
            </Style>

        </Styles>
    </Application.Styles>
</Application>
