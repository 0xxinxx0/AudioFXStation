<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AudioFXStation.MainWindow"
        Title="AudioFXStation"
        Width="1100"
        Height="700"
        MinWidth="850"
        MinHeight="550"
        Background="#0C1117"
        Foreground="#E8EAF0">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#18212A"/>
            <Setter Property="Foreground" Value="#DCE5E4"/>
            <Setter Property="BorderBrush" Value="#25323A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15,9"/>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#223039"/>
            <Setter Property="BorderBrush" Value="#607A61"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#1A2828"/>
            <Setter Property="BorderBrush" Value="#B9E57A"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="68,*,96">
        <Grid ColumnDefinitions="*,Auto"
              Margin="22,0">
            <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="Audio Visualizer" FontSize="17" FontWeight="Bold" Foreground="#F0F4EF"/>
                <TextBlock x:Name="FileNameText" Text="No audio loaded" FontSize="11" Foreground="#91A09C"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Choose a file" Click="OpenAudio_Click"
                    Background="#C6F277" Foreground="#151A10"
                    BorderBrush="#D8FFA0" Padding="18,9" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,280" Margin="22,10">
            <Grid RowDefinitions="*,*">
                <Border Background="#151D26" BorderBrush="#1F2C34" BorderThickness="1" CornerRadius="18" Padding="17" Margin="0,0,14,12">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="Waveform" FontSize="15" FontWeight="SemiBold"/>
                        <Border Grid.Row="1" Background="#0E151B" BorderBrush="#19262D" BorderThickness="1" CornerRadius="12" Margin="0,15,0,0">
                            <Canvas x:Name="WaveformCanvas" ClipToBounds="True"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#151D26" BorderBrush="#1F2C34" BorderThickness="1" CornerRadius="18" Padding="17" Margin="0,0,14,0">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Text="Spectrum" FontSize="15" FontWeight="SemiBold"/>
                        <Border Grid.Row="1" Background="#0E151B" BorderBrush="#19262D" BorderThickness="1" CornerRadius="12" Margin="0,15,0,0">
                            <TextBlock Text="Waiting for audio..."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#91A09C"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="*,*">
                <Border Background="#151D26" BorderBrush="#1F2C34" BorderThickness="1" CornerRadius="18" Padding="17" Margin="0,0,0,12">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Text="Equalizer" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="2" Text="EQ not available yet"
                                    FontSize="10" Foreground="#91A09C"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#151D26" BorderBrush="#1F2C34" BorderThickness="1" CornerRadius="18" Padding="17">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Effects" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="High-Pass Filter" Foreground="#C1CCC9"/>
                        <TextBlock Text="Compressor" Foreground="#C1CCC9"/>
                        <TextBlock Text="..." FontSize="10" Foreground="#91A09C"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#151D26" BorderBrush="#1F2C34" BorderThickness="1,1,1,0" Padding="22,14">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="▶" Click="Play_Click" Background="#C6F277" Foreground="#151A10" Padding="16,8"/>
                    <Button Content="Ⅱ" Click="Pause_Click" Padding="14,8"/>
                    <Button Content="■" Click="Stop_Click" Padding="14,8"/>
                </StackPanel>

                <TextBlock x:Name="PositionText" Grid.Column="1" Text="00:00 / 00:00"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Slider x:Name="SeekSlider" Grid.Row="1" Grid.ColumnSpan="3"
                        Minimum="0" Maximum="100" Value="0" Margin="0,12,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>