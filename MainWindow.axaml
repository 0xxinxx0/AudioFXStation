<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AudioFXStation.MainWindow"
        Title="AudioFXStation"
        Width="1100"
        Height="700"
        MinWidth="850"
        MinHeight="550"
        Foreground="#F0F3F4">

    <Window.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#111A16" Offset="0"/>
            <GradientStop Color="#0B1018" Offset="0.52"/>
            <GradientStop Color="#11181B" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Background" Value="#202B27"/>
            <Setter Property="Foreground" Value="#E7ECEE"/>
            <Setter Property="BorderBrush" Value="#3B493E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#2E3D32"/>
            <Setter Property="BorderBrush" Value="#718957"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#334638"/>
            <Setter Property="BorderBrush" Value="#C6F277"/>
            <Setter Property="Opacity" Value="0.88"/>
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#C6F277"/>
            <Setter Property="Foreground" Value="#18200F"/>
            <Setter Property="BorderBrush" Value="#D8FFA0"/>
        </Style>
        <Style Selector="Button.accent:pointerover">
            <Setter Property="Background" Value="#D2F995"/>
            <Setter Property="BorderBrush" Value="#E4FFB8"/>
        </Style>
        <Style Selector="Button.accent:pressed">
            <Setter Property="Background" Value="#A9D85D"/>
            <Setter Property="BorderBrush" Value="#C6F277"/>
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#E7ECEE"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="76,*,94">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="26,0">
            <Border Width="40" Height="40" CornerRadius="14" Background="#25311F" BorderBrush="#586A3C" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock Text="A" FontSize="20" FontWeight="Bold" Foreground="#C6F277" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="13,0,0,0" Spacing="3">
                <TextBlock Text="AudioFX Station" FontSize="18" FontWeight="Bold" Foreground="#F1F4F2"/>
                <TextBlock x:Name="FileNameText" Text="No audio loaded" FontSize="11" Foreground="#93A09D"/>
            </StackPanel>
            <Button Grid.Column="2" Classes="accent" Content="Choose a file" Click="OpenAudio_Click" Padding="19,10" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,292" Margin="26,8">
            <Grid RowDefinitions="1.08*,0.92*">
                <Border Background="#E017211F" BorderBrush="#3A473C" BorderThickness="1" CornerRadius="20" Padding="18" Margin="0,0,14,12">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Waveform" FontSize="15" FontWeight="SemiBold" Foreground="#F0F3F4"/>
                            <TextBlock Text="AUDIO SIGNAL" FontSize="9" FontWeight="SemiBold" Foreground="#909A87"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#0D1411" BorderBrush="#2A382E" BorderThickness="1" CornerRadius="14" Margin="0,12,0,0">
                            <Canvas x:Name="WaveformCanvas" ClipToBounds="True"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#E017211F" BorderBrush="#3A473C" BorderThickness="1" CornerRadius="20" Padding="18" Margin="0,0,14,0">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Frequency spectrum" FontSize="15" FontWeight="SemiBold" Foreground="#F0F3F4"/>
                            <TextBlock Text="REAL-TIME ANALYSIS" FontSize="9" FontWeight="SemiBold" Foreground="#909A87"/>
                        </StackPanel>
                        <Border Grid.Row="1" Background="#0D1411" BorderBrush="#2A382E" BorderThickness="1" CornerRadius="14" Margin="0,12,0,0">
                            <Canvas x:Name="SpectrumCanvas" ClipToBounds="True"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="1" RowDefinitions="1.15*,0.85*">
                <Border Background="#E017211F" BorderBrush="#3A473C" BorderThickness="1" CornerRadius="20" Padding="18" Margin="0,0,0,12">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Equalizer" FontSize="15" FontWeight="SemiBold" Foreground="#F0F3F4"/>
                            <TextBlock Text="3-BAND TONE CONTROL" FontSize="9" FontWeight="SemiBold" Foreground="#909A87"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="3" Margin="0,10,0,0">
                            <TextBlock Text="BASS" Foreground="#AEB8AA" FontSize="10" FontWeight="SemiBold"/>
                            <Slider x:Name="BassSlider" Minimum="-12" Maximum="12" Value="0" Height="35"/>
                            <TextBlock Text="MID" Foreground="#AEB8AA" FontSize="10" FontWeight="SemiBold"/>
                            <Slider x:Name="MidSlider" Minimum="-12" Maximum="12" Value="0" Height="35"/>
                            <TextBlock Text="TREBLE" Foreground="#AEB8AA" FontSize="10" FontWeight="SemiBold"/>
                            <Slider x:Name="TrebleSlider" Minimum="-12" Maximum="12" Value="0" Height="35"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="#E017211F" BorderBrush="#3A473C" BorderThickness="1" CornerRadius="20" Padding="18">
                    <StackPanel Spacing="7" VerticalAlignment="Center">
                        <CheckBox x:Name="HighPassToggle" Content="High-Pass Filter" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="Cutoff frequency" Foreground="#AEB8AA" FontSize="11" Margin="0,4,0,0"/>
                        <Slider x:Name="HighPassSlider" Minimum="20" Maximum="500" Value="100" Height="35"/>
                        <TextBlock x:Name="HighPassValue" Text="100 Hz" Foreground="#C6F277" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#F0141D19" BorderBrush="#3A473C" BorderThickness="1,1,1,0" Padding="26,12">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent" Content="▶" Click="Play_Click" Padding="17,8"/>
                    <Button Content="Ⅱ" Click="Pause_Click" Padding="15,8"/>
                    <Button Content="■" Click="Stop_Click" Padding="15,8"/>
                </StackPanel>
                <TextBlock x:Name="PositionText" Grid.Column="1" Text="00:00 / 00:00" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#D6DEDA"/>
                <Slider x:Name="SeekSlider" Grid.Row="1" Grid.ColumnSpan="3" Minimum="0" Maximum="100" Value="0" Margin="0,9,0,0" Height="35"/>
            </Grid>
        </Border>
    </Grid>
</Window>